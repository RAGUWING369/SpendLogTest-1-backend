# SpendLog Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the .env file — it is in .gitignore.

# PostgreSQL connection URL (asyncpg dialect for SQLAlchemy async engine)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/spendlog

# JWT signing secret — generate with: openssl rand -hex 32
SECRET_KEY=replace-this-with-a-strong-random-secret-at-least-32-chars

# JWT algorithm (HS256 is the project standard)
ALGORITHM=HS256

# Access token lifetime in minutes (default: 30 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days (default: 7 days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend origin for CORS allow-list (Vite dev server default)
FRONTEND_URL=http://localhost:5173
