# SpendLog Backend — Environment Variables
# Copy this file to .env and fill in real values before running the application.
# NEVER commit the .env file — it contains secrets. See .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
# Async SQLAlchemy connection string (asyncpg dialect).
# Production: use Supabase pooled URL (port 6543) for the application.
# Migrations: use the direct URL (port 5432) for Alembic — see alembic.ini.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/spendlog

# ── JWT Authentication ────────────────────────────────────────────────────────
# SECRET_KEY: a cryptographically random string — at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-secure-random-secret-key

# Signing algorithm — do not change unless you know what you are doing.
ALGORITHM=HS256

# Access token lifetime in minutes (default: 30).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days (default: 7).
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# The frontend origin that the API will accept cross-origin requests from.
# Local development: http://localhost:5173
# Production: your Vercel deployment URL (e.g. https://spendlog.vercel.app)
FRONTEND_URL=http://localhost:5173

# ── Runtime Environment ───────────────────────────────────────────────────────
# Controls OpenAPI docs visibility and other environment-specific behaviour.
# Allowed values: development | testing | production
# OpenAPI /docs and /redoc are disabled when ENVIRONMENT=production.
ENVIRONMENT=development
