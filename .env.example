# SpendLog Backend — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env before starting the server:
#   cp .env.example .env
#
# Then fill in real values for DATABASE_URL and SECRET_KEY at minimum.
# NEVER commit .env — it is excluded from version control by .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL async connection string (asyncpg driver)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# For Supabase PgBouncer (production): use port 6543
# For direct Alembic migrations: use port 5432
DATABASE_URL=postgresql+asyncpg://spendlog_user:change_me@localhost:5432/spendlog_db

# JWT signing secret — must be at least 32 characters, randomly generated
# Generate a secure value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-secure-random-32-char-minimum-secret-key

# JWT algorithm — HS256 (HMAC-SHA256) is the project standard; do not change
ALGORITHM=HS256

# Access token lifetime in minutes (short-lived; default 30 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days (long-lived; default 7 days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend origin allowed by CORS (no trailing slash)
# Local development: http://localhost:5173 (Vite default)
# Production: set to the deployed Vercel URL (e.g. https://spendlog.vercel.app)
FRONTEND_URL=http://localhost:5173
