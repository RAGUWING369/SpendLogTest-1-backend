# SpendLog Backend — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before running the application.
#
#   cp .env.example .env
#
# NEVER commit the .env file — it is listed in .gitignore and contains secrets.
# This file (.env.example) contains only safe placeholder values and IS safe
# to commit.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Async SQLAlchemy connection string (asyncpg dialect).
# Format:  postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
#
# Local development (default):
#   postgresql+asyncpg://user:password@localhost:5432/spendlog
#
# Production — Supabase:
#   Use the POOLED URL (port 6543) for the application runtime (PgBouncer).
#   Use the DIRECT URL (port 5432) for Alembic migrations — set in alembic.ini.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/spendlog

# ── JWT Authentication ────────────────────────────────────────────────────────
# SECRET_KEY: a cryptographically random string — minimum 32 characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-secure-random-secret-key-min-32-chars

# Signing algorithm — do not change without a corresponding ADR update.
# Supported values: HS256 (symmetric HMAC-SHA256, used for access and refresh tokens).
ALGORITHM=HS256

# Access token lifetime in minutes.
# Default: 30 minutes — balanced between security and user experience.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days.
# Default: 7 days — requires re-login after one week of inactivity.
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# The frontend origin that the API accepts cross-origin requests from.
# Local development: http://localhost:5173 (Vite default dev server port)
# Production: your Vercel deployment URL (e.g. https://spendlog.vercel.app)
FRONTEND_URL=http://localhost:5173

# ── Runtime Environment ───────────────────────────────────────────────────────
# Controls OpenAPI docs visibility and environment-specific behaviour.
# Allowed values: development | testing | production
# Note: /docs and /redoc endpoints are disabled when ENVIRONMENT=production.
ENVIRONMENT=development
