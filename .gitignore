dist/
build/
*.egg-info/
.eggs/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Windows
Thumbs.db
